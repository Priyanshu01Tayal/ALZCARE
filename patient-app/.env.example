# AlzCare Patient Mobile App Environment Configuration Template
# Configure this with your reachable backend URL.
# Note: Do NOT use http://localhost or http://127.0.0.1 on physical Android phones.

# Local Physical Device Testing (same Wi-Fi network as backend):
EXPO_PUBLIC_API_URL=http://192.168.1.4:5000/api

# Android Studio Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Production / Deployed Backend (for APK testing outside local Wi-Fi):
# EXPO_PUBLIC_API_URL=https://YOUR-BACKEND-URL/api
