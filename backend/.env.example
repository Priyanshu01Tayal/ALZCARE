# ==============================================================================
# ALZCARE Backend Environment Configuration Template
# ==============================================================================

# Port configuration (Local defaults to 5000; Render dynamically assigns PORT=10000)
PORT=5000

# ------------------------------------------------------------------------------
# MongoDB Connection String:
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
MONGO_URI=mongodb://127.0.0.1:27017/alzcare

# RENDER PRODUCTION (Configure in Render Dashboard -> Service -> Environment):
# Note: Ensure IP 0.0.0.0/0 is whitelisted in MongoDB Atlas -> Network Access
# MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxx.mongodb.net/alzcare?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Security & Auth:
# ------------------------------------------------------------------------------
JWT_SECRET=your_secure_jwt_secret_key_here
NODE_ENV=development

# ------------------------------------------------------------------------------
# External Services:
# ------------------------------------------------------------------------------
ML_SERVICE_URL=https://alzheimer-ml-deployment.onrender.com/predict

# Optional: Restrict CORS origins in production (comma-separated, or leave blank to allow all)
# CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000
